{"version":"0.3.0","body":"function main(workbook: ExcelScript.Workbook) {\n    const mainWorksheetName = \"Tasks\";\n    const outputWorksheetName = \"Timeline\";\n\n    interface Task {\n        project: string;\n        task: string;\n        status: string;\n        start: Date | null;\n        end: Date | null;\n    }\n\n    const mainSheet = workbook.getWorksheet(mainWorksheetName);\n    if (!mainSheet) {\n        console.log(`Worksheet \"${mainWorksheetName}\" not found.`);\n        return;\n    }\n\n    let outputSheet = workbook.getWorksheet(outputWorksheetName);\n    if (!outputSheet) {\n        outputSheet = workbook.addWorksheet(outputWorksheetName);\n    }\n\n    // read filter dates (B1 e B2)\n    const filterStartValue = outputSheet.getRange(\"B1\").getValue();\n    const filterEndValue = outputSheet.getRange(\"B2\").getValue();\n\n    // detect date values\n    function isDate(value: unknown): value is Date {\n        return (\n            Object.prototype.toString.call(value) === \"[object Date]\" &&\n            !isNaN((value as Date).getTime())\n        );\n    }\n\n    // convert excel values to date format\n    function parseDate(value: unknown): Date | null {\n        if (typeof value === \"number\") {\n            const excelEpoch = new Date(Date.UTC(1899, 11, 30));\n            return new Date(excelEpoch.getTime() + value * 86400000);\n        }\n        if (isDate(value)) {\n            return value as Date;\n        }\n        if (typeof value === \"string\") {\n            const d = new Date(value);\n            return isNaN(d.getTime()) ? null : d;\n        }\n        return null;\n    }\n\n    const filterStart = parseDate(filterStartValue);\n    const filterEnd = parseDate(filterEndValue);\n\n    if (!filterStart || !filterEnd) {\n        console.log(\"Enter a valid start (B1) and end (B2) dates.\");\n        return;\n    }\n\n    filterStart.setHours(0, 0, 0, 0);\n    filterEnd.setHours(0, 0, 0, 0);\n\n    const usedRange = mainSheet.getUsedRange();\n    if (!usedRange) {\n        console.log(\"No data found.\");\n        return;\n    }\n\n    const values = usedRange.getValues();\n    const headers = values[0] as string[];\n    const rows = values.slice(1);\n\n    const projectIdx = headers.findIndex((h) => h.toLowerCase() === \"project\");\n    const taskIdx = headers.findIndex((h) => h.toLowerCase() === \"task\");\n    const statusIdx = headers.findIndex((h) => h.toLowerCase() === \"status\");\n    const startIdx = headers.findIndex((h) => h.toLowerCase() === \"start\");\n    const endIdx = headers.findIndex((h) => h.toLowerCase() === \"finish\");\n\n    if (\n        projectIdx === -1 ||\n        taskIdx === -1 ||\n        statusIdx === -1 ||\n        startIdx === -1 ||\n        endIdx === -1\n    ) {\n        console.log(\"Required colums not found.\");\n        return;\n    }\n\n    const tasks: Task[] = [];\n\n    for (const row of rows) {\n        const project = row[projectIdx]?.toString().trim() || \"\";\n        const task = row[taskIdx]?.toString().trim() || \"\";\n        const status = row[statusIdx]?.toString().toLowerCase() || \"\";\n\n        const start = parseDate(row[startIdx]);\n        const end = parseDate(row[endIdx]);\n\n        if (!project || !task) continue;\n\n        tasks.push({ project, task, status, start, end });\n    }\n\n    const today = new Date();\n    today.setHours(0, 0, 0, 0);\n\n    // calculate filtered days\n    const totalDays = Math.floor(\n        (filterEnd.getTime() - filterStart.getTime()) / (1000 * 3600 * 24)\n    );\n\n    const daysRange: string[] = [];\n    const dateMap: { [key: string]: number } = {};\n\n    for (let d = 0; d <= totalDays; d++) {\n        const date = new Date(filterStart);\n        date.setDate(date.getDate() + d);\n        const dateStr = date.toLocaleDateString(\"pt-BR\");\n        daysRange.push(dateStr);\n        dateMap[dateStr] = d;\n    }\n\n    // filter tasks within the selected period\n    const filteredTasks = tasks.filter(task => {\n        if (!task.start) return false;\n        \n        // has information?\n        const taskEnd = task.end || task.start;\n        \n        // check whether the task overlaps with the selected date range\n        return task.start <= filterEnd && taskEnd >= filterStart;\n    });\n\n    if (filteredTasks.length === 0) {\n        console.log(\"No tasks found within the selected period.\");\n        return;\n    }\n\n    // clean timeline (starting at D1)\n    const maxRows = filteredTasks.length + 1;\n    const maxCols = daysRange.length + 3;\n    outputSheet.getRangeByIndexes(0, 3, maxRows, maxCols).clear();\n\n    // timeline header starting at D1\n    const headerRow = [\"PROJECT\", \"TASK\", \"STATUS\", ...daysRange];\n    outputSheet.getRangeByIndexes(0, 3, 1, headerRow.length).setValues([headerRow]);\n\n    // apply header formating\n    const headerRange = outputSheet.getRangeByIndexes(0, 3, 1, headerRow.length);\n    headerRange.getFormat().getFill().setColor(\"#000000\");\n    headerRange.getFormat().getFont().setColor(\"#FFFFFF\");\n    headerRange.getFormat().getFont().setBold(true);\n    headerRange.getFormat().setHorizontalAlignment(ExcelScript.HorizontalAlignment.center);\n    headerRange.getFormat().setVerticalAlignment(ExcelScript.VerticalAlignment.center);\n\n    // pastel color palette used to automatically identify projects\n    const pastelPalette: string[] = [\n        \"#D4E6F1\", // pastel blue\n        \"#E8DAEF\", // pastel purple\n        \"#D5F5E3\", // pastel green\n        \"#FCF3CF\", // pastel yellow\n        \"#FADBD8\", // pastel pink\n        \"#FDEDEC\", // soft pink\n        \"#EBDEF0\", // pastel lilac\n        \"#EAEDED\", // blue gray\n        \"#EAF2F8\", // ice blue\n        \"#D6EAF8\", // sky blue\n        \"#D1F2EB\", // aqua\n        \"#E8F8F5\", // mint\n        \"#F9E79F\", // soft yellow\n        \"#F5CBA7\", // peach\n        \"#EDBB99\", // pastel orange\n        \"#D7BDE2\", // lavender\n        \"#D2B4DE\", // violet\n        \"#A9DFBF\", // sage green\n        \"#AED6F1\", // powder blue\n        \"#F5EEF8\"  // very light purple\n    ];\n\n    // create a color map automatically for each project\n    const projectColors: { [key: string]: string } = {};\n\n    let projectColorIndex = 0;\n\n    tasks.forEach(task => {\n        if (!projectColors[task.project]) {\n            projectColors[task.project] =\n                pastelPalette[projectColorIndex % pastelPalette.length];\n\n            projectColorIndex++;\n        }\n    });\n\n    // status colors\n    const statusColors: { [key: string]: string } = {\n        \"completed\": \"#A9DFBF\",     // light green\n        \"on hold\": \"#FCF3CF\",       // light yellow\n        \"in progress\": \"#AED6F1\",   // light blue\n        \"not started\": \"#E5E7E9\"    // light gray\n    };\n\n    filteredTasks.forEach((task, i) => {\n        const rowIdx = i + 1;\n        const colOffset = 3;\n\n        // populate cells\n        outputSheet.getCell(rowIdx, colOffset).setValue(task.project);\n        outputSheet.getCell(rowIdx, colOffset + 1).setValue(task.task);\n        outputSheet.getCell(rowIdx, colOffset + 2).setValue(task.status);\n\n        // apply background color\n        //const projectColor = projectColors[task.project] || projectColors[\"default\"];\n        const projectColor = projectColors[task.project] || \"#F0F0F0\";\n        const rowRange = outputSheet.getRangeByIndexes(rowIdx, colOffset, 1, headerRow.length);\n        rowRange.getFormat().getFill().setColor(projectColor);\n\n        // format status with specific color\n        const statusCell = outputSheet.getCell(rowIdx, colOffset + 2);\n        statusCell.getFormat().getFill().setColor(statusColors[task.status] || \"#E5E7E9\");\n        statusCell.getFormat().getFont().setBold(true);\n\n        // center content\n        rowRange.getFormat().setVerticalAlignment(ExcelScript.VerticalAlignment.center);\n\n        // draw timeline\n        if (task.start) {\n            let taskEndDate = task.end;\n            if (task.status === \"in progress\") {\n                taskEndDate = task.end && task.end < today ? task.end : today;\n            }\n\n            const startOffset = Math.floor(\n                (task.start.getTime() - filterStart.getTime()) / (1000 * 3600 * 24)\n            );\n            const endOffset = taskEndDate\n                ? Math.floor((taskEndDate.getTime() - filterStart.getTime()) / (1000 * 3600 * 24))\n                : startOffset;\n\n            // progress bar color based on status\n            let barColor = \"#5DADE2\";                       // blue\n            if (task.status === \"completed\") {\n                barColor = \"#58D68D\";                       // green\n            } else if (task.status === \"on hold\") {\n                barColor = \"#F8C471\";                       // yellow/orange\n            } else if (task.status === \"in progress\") {\n                barColor = \"#5DADE2\";                       // blue\n            }\n\n            for (let d = startOffset; d <= endOffset; d++) {\n                if (d >= 0 && d <= totalDays) {\n                    const cell = outputSheet.getCell(rowIdx, d + colOffset + 3);\n                    cell.setValue(\"█\");\n                    cell.getFormat().getFill().setColor(barColor);\n                    cell.getFormat().getFont().setColor(barColor);\n                    cell.getFormat().setHorizontalAlignment(ExcelScript.HorizontalAlignment.center);\n                }\n            }\n        }\n    });\n\n    // highlight current date\n    const todayStr = today.toLocaleDateString(\"pt-BR\");\n    const todayIdx = dateMap[todayStr];\n    if (todayIdx !== undefined) {\n        const colIdx = todayIdx + 6;    // cell D + 3 (PROJECT, TASK, STATUS) + days\n        \n        // header\n        const headerCell = outputSheet.getCell(0, colIdx);\n        headerCell.getFormat().getFill().setColor(\"#FF6B6B\");\n        \n        // highlight all cells for the currnt date\n        for (let i = 0; i < filteredTasks.length; i++) {\n            const cell = outputSheet.getCell(i + 1, colIdx);\n            const currentFill = cell.getFormat().getFill().getColor();\n            // don't overwrite cells that already contain a progress bar\n            if (cell.getValue() !== \"█\") {\n                cell.getFormat().getFill().setColor(\"#FFE5E5\");\n            }\n        }\n    }\n\n    // add borders\n    const fullRange = outputSheet.getRangeByIndexes(0, 3, maxRows, maxCols);\n    fullRange.getFormat().getRangeBorder(ExcelScript.BorderIndex.edgeTop).setStyle(ExcelScript.BorderLineStyle.continuous);\n    fullRange.getFormat().getRangeBorder(ExcelScript.BorderIndex.edgeBottom).setStyle(ExcelScript.BorderLineStyle.continuous);\n    fullRange.getFormat().getRangeBorder(ExcelScript.BorderIndex.edgeLeft).setStyle(ExcelScript.BorderLineStyle.continuous);\n    fullRange.getFormat().getRangeBorder(ExcelScript.BorderIndex.edgeRight).setStyle(ExcelScript.BorderLineStyle.continuous);\n    fullRange.getFormat().getRangeBorder(ExcelScript.BorderIndex.insideHorizontal).setStyle(ExcelScript.BorderLineStyle.continuous);\n    fullRange.getFormat().getRangeBorder(ExcelScript.BorderIndex.insideVertical).setStyle(ExcelScript.BorderLineStyle.continuous);\n\n    // autofit collums\n    const timelineRange = outputSheet.getRangeByIndexes(0, 3, maxRows, maxCols);\n    timelineRange.getFormat().autofitColumns();\n\n    outputSheet.activate();\n}","description":"","noCodeMetadata":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}